@Article{Takayama2015,
  author   = {Takayama, Ken-ichi and Inoue, Satoshi},
  journal  = {Briefings in Functional Genomics},
  title    = {{The emerging role of noncoding RNA in prostate cancer progression and its implication on diagnosis and treatment}},
  year     = {2015},
  issn     = {2041-2649},
  month    = {12},
  number   = {3},
  pages    = {257-265},
  volume   = {15},
  abstract = {{Recent transcriptome studies using next-generation sequencing have detected aberrant changes in the expression of noncoding RNAs (ncRNAs) associated with cancer. For prostate cancer, the expression levels of ncRNAs including microRNAs and long noncoding RNAs are strongly associated with diagnosis, carcinogenesis and tumor growth. Moreover, androgen and its cognate receptor, androgen receptor (AR), regulate various signaling pathways for prostate tumor growth. In addition, progression to lethal castration-resistant prostate cancer (CRPC) is also owing to AR function. Systematic analysis of AR-binding sites and their regulated transcripts revealed that many ncRNAs are widely regulated at the transcriptional level. Thus, recent studies provide new insight into the complicated molecular mechanism of prostate cancer progression. This review focused on the role of various ncRNAs in prostate cancer and the association between their expression and CRPC.}},
  doi      = {10.1093/bfgp/elv057},
  eprint   = {https://academic.oup.com/bfg/article-pdf/15/3/257/6684852/elv057.pdf},
  url      = {https://doi.org/10.1093/bfgp/elv057},
}

